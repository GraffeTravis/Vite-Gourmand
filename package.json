{
  "name": "vite-et-gourmand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/run-next.ts dev --hostname 0.0.0.0",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build",
    "start": "node --import tsx scripts/run-next.ts start --hostname 0.0.0.0",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:unit": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:integration": "node node_modules/tsx/dist/cli.mjs scripts/test-integration.ts",
    "test:e2e": "node --import tsx scripts/test-browser.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:validate": "node node_modules/prisma/build/index.js validate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "db:seed:demo": "node --import tsx prisma/seed-demo.ts",
    "db:seed:hours": "node --import tsx prisma/seed-business-hours.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "services:up": "docker compose up -d postgres mongo mailpit",
    "services:down": "docker compose down",
    "postinstall": "node node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "mongodb": "^7.0.0",
    "next": "^16.0.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
