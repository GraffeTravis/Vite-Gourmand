# Identifiants locaux de développement uniquement. Ne pas réutiliser en production.
APP_ENV=development
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vg:vg_local_only@localhost:5433/vite_gourmand
# Neon renseigne aussi DATABASE_URL_UNPOOLED pour les migrations ; garder cette valeur secrète.
# En local, son absence fait utiliser DATABASE_URL. Ne pas copier une URL distante dans .env.test.
MONGODB_URI=mongodb://vg:vg_local_only@localhost:27017/?authSource=admin
MONGODB_DATABASE=vite_gourmand_analytics
SMTP_HOST=localhost
# smtp par défaut ; disabled autorise le catalogue sans aucun envoi d'e-mails.
MAIL_TRANSPORT=smtp
SMTP_PORT=1025
SMTP_FROM=Vite & Gourmand <bonjour@vite-gourmand.test>
APP_URL=http://localhost:3000
